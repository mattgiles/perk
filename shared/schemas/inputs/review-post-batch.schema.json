      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "comments": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ReviewCommentInput"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comments"
    },
    "fyi": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fyi"
    },
    "expected_pr": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Pr"
    }
  },
  "required": [
    "verdict",
    "summary"
  ],
  "title": "ReviewBatchInput",
  "type": "object"
