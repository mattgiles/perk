          "enum": [
            "probed",
            "pinned",
            "recent",
            "missing",
            "failed"
          ],
          "title": "Action",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "entry": {
          "$ref": "#/$defs/EntryOut"
        }
      },
      "required": [
        "action",
        "detail",
        "notes",
        "entry"
      ],
      "title": "CheckResultOut",
      "type": "object"
    },
