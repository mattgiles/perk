        },
        "stale_after": {
          "title": "Stale After",
          "type": "integer"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "drifted": {
          "title": "Drifted",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/Status"
        }
