      "type": "string"
    },
    "UncataloguedOut": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "hint": {
          "title": "Hint",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "hint"
      ],
      "title": "UncataloguedOut",
      "type": "object"
    }
