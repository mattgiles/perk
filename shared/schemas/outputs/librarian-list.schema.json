      "required": [
        "kind",
        "slug",
        "source",
        "path",
        "present",
        "ref",
        "added_at",
        "checked_at",
        "checked_age_seconds",
        "stale_after",
        "evidence",
        "drifted",
        "status"
      ],
      "title": "EntryOut",
      "type": "object"
    },
