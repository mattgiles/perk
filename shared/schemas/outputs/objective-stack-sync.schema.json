        "id": {
          "title": "Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "redirected_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Redirected From"
        }
      },
      "required": [
        "id",
        "url",
        "redirected_from"
      ],
      "title": "ObjectiveOut",
      "type": "object"
    },
    "SyncedLayerOut": {
