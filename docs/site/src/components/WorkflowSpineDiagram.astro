{/*
  The workflow-spine diagram — the first of the five-diagram family, conforming to the
  shared legend and rendering contract (docs/design/docs-site-visual-blueprint.md §5):
  hand-authored theme-aware inline SVG, colors only from the bound token custom properties
  (--perk-* / --sl-color-*), operational labels IBM Plex Mono 500 at >= 16 CSS px,
  annotations Inter, no animation, nothing hover-only.

  One <figure class="perk-diagram"> wraps two fully-labeled <svg role="img"> variants
  (data-variant="wide" horizontal, data-variant="narrow" stacked vertical, same reading
  order); the scoped media query display:none's exactly one at any width, removing it from
  rendering AND the accessibility tree so a single accessible image is exposed. Each variant
  carries its own <title> + <desc> associated via aria-labelledby (document-unique ids).

  `implement` is shown highlighted (2px accent, leading ▸) as an example in-flight stage —
  the <desc> and the adjacent textual equivalent in the home page say so. The connector into
  `address` is dashed with the condition label "(if review asks)" (conditional step: ◇ +
  dashed incoming arrow + condition text).

  Deliberately static and prop-free: a malformed component fails `astro build`, and the
  post-build structural checks (docs/site/checks/built-site.test.mjs) cover the output.
*/}

<figure class="perk-diagram">
  <svg
    role="img"
    data-variant="wide"
    viewBox="0 0 736 88"
    aria-labelledby="perk-spine-wide-title perk-spine-wide-desc"
  >
    <title id="perk-spine-wide-title">The perk workflow spine</title>
    <desc id="perk-spine-wide-desc">
      Seven stages connected left to right: plan, save, implement, submit, address, land,
      learn. Implement is shown highlighted as an example in-flight stage. The connector
      into address is dashed and labeled "if review asks" — address is conditional; every
      other connector is solid.
    </desc>
    <g>
      <rect class="stage" x="2" y="12" width="74" height="36" rx="6" />
      <text class="stage-label" x="39" y="36">○ plan</text>
      <line class="connector" x1="76" y1="30" x2="88" y2="30" />
      <polygon class="arrowhead" points="88,26.5 88,33.5 94,30" />

      <rect class="stage" x="94" y="12" width="74" height="36" rx="6" />
      <text class="stage-label" x="131" y="36">○ save</text>
      <line class="connector" x1="168" y1="30" x2="180" y2="30" />
      <polygon class="arrowhead" points="180,26.5 180,33.5 186,30" />

      <rect class="stage current" x="186" y="12" width="122" height="36" rx="6" />
      <text class="stage-label current-label" x="247" y="36">▸ implement</text>
      <line class="connector" x1="308" y1="30" x2="320" y2="30" />
      <polygon class="arrowhead" points="320,26.5 320,33.5 326,30" />

      <rect class="stage" x="326" y="12" width="93" height="36" rx="6" />
      <text class="stage-label" x="372.5" y="36">○ submit</text>
      <line class="connector conditional" x1="419" y1="30" x2="431" y2="30" />
      <polygon class="arrowhead" points="431,26.5 431,33.5 437,30" />

      <rect class="stage" x="437" y="12" width="103" height="36" rx="6" />
      <text class="stage-label" x="488.5" y="36">◇ address</text>
      <text class="condition-label" x="488.5" y="76">(if review asks)</text>
      <line class="connector" x1="540" y1="30" x2="552" y2="30" />
      <polygon class="arrowhead" points="552,26.5 552,33.5 558,30" />

      <rect class="stage" x="558" y="12" width="74" height="36" rx="6" />
      <text class="stage-label" x="595" y="36">○ land</text>
      <line class="connector" x1="632" y1="30" x2="644" y2="30" />
      <polygon class="arrowhead" points="644,26.5 644,33.5 650,30" />

      <rect class="stage" x="650" y="12" width="84" height="36" rx="6" />
      <text class="stage-label" x="692" y="36">○ learn</text>
    </g>
  </svg>
  <svg
    role="img"
    data-variant="narrow"
    viewBox="0 0 288 404"
    aria-labelledby="perk-spine-narrow-title perk-spine-narrow-desc"
  >
    <title id="perk-spine-narrow-title">The perk workflow spine (stacked)</title>
    <desc id="perk-spine-narrow-desc">
      Seven stages connected top to bottom: plan, save, implement, submit, address, land,
      learn. Implement is shown highlighted as an example in-flight stage. The connector
      into address is dashed and labeled "if review asks" — address is conditional; every
      other connector is solid.
    </desc>
    <g>
      <rect class="stage" x="2" y="4" width="74" height="36" rx="6" />
      <text class="stage-label" x="39" y="28">○ plan</text>
      <line class="connector" x1="39" y1="40" x2="39" y2="58" />
      <polygon class="arrowhead" points="35.5,58 42.5,58 39,64" />

      <rect class="stage" x="2" y="64" width="74" height="36" rx="6" />
      <text class="stage-label" x="39" y="88">○ save</text>
      <line class="connector" x1="39" y1="100" x2="39" y2="118" />
      <polygon class="arrowhead" points="35.5,118 42.5,118 39,124" />

      <rect class="stage current" x="2" y="124" width="122" height="36" rx="6" />
      <text class="stage-label current-label" x="63" y="148">▸ implement</text>
      <line class="connector" x1="39" y1="160" x2="39" y2="178" />
      <polygon class="arrowhead" points="35.5,178 42.5,178 39,184" />

      <rect class="stage" x="2" y="184" width="93" height="36" rx="6" />
      <text class="stage-label" x="48.5" y="208">○ submit</text>
      <line class="connector conditional" x1="39" y1="220" x2="39" y2="238" />
      <polygon class="arrowhead" points="35.5,238 42.5,238 39,244" />

      <rect class="stage" x="2" y="244" width="103" height="36" rx="6" />
      <text class="stage-label" x="53.5" y="268">◇ address</text>
      <text class="condition-label" x="115" y="268">(if review asks)</text>
      <line class="connector" x1="39" y1="280" x2="39" y2="298" />
      <polygon class="arrowhead" points="35.5,298 42.5,298 39,304" />

      <rect class="stage" x="2" y="304" width="74" height="36" rx="6" />
      <text class="stage-label" x="39" y="328">○ land</text>
      <line class="connector" x1="39" y1="340" x2="39" y2="358" />
      <polygon class="arrowhead" points="35.5,358 42.5,358 39,364" />

      <rect class="stage" x="2" y="364" width="84" height="36" rx="6" />
      <text class="stage-label" x="44" y="388">○ learn</text>
    </g>
  </svg>
</figure>

<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
  }
  svg[data-variant="wide"] {
    max-width: 736px;
  }
  svg[data-variant="narrow"] {
    max-width: 288px;
    display: none;
  }
  @media (max-width: 767.98px) {
    svg[data-variant="wide"] {
      display: none;
    }
    svg[data-variant="narrow"] {
      display: block;
    }
  }

  .stage {
    fill: var(--perk-surface);
    stroke: var(--perk-border);
    stroke-width: 1;
  }
  .stage.current {
    stroke: var(--perk-accent);
    stroke-width: 2;
  }
  .stage-label {
    font-family: var(--sl-font-mono), monospace;
    font-size: 16px;
    font-weight: 500;
    fill: var(--perk-text);
    text-anchor: middle;
  }
  .current-label {
    fill: var(--perk-accent);
  }
  .connector {
    stroke: var(--perk-muted);
    stroke-width: 1;
    fill: none;
  }
  .connector.conditional {
    stroke-dasharray: 4 3;
  }
  .arrowhead {
    fill: var(--perk-muted);
  }
  .condition-label {
    font-family: var(--sl-font), sans-serif;
    font-size: 16px;
    fill: var(--perk-muted);
    text-anchor: middle;
  }
  svg[data-variant="narrow"] .condition-label {
    text-anchor: start;
  }
</style>
