      display: none;
    }
    svg[data-variant="narrow"] {
      display: block;
    }
  }

  .stage,
  .matrix-cell {
    stroke: var(--perk-border);
    stroke-width: 1;
  }
  .stage {
    fill: var(--perk-surface);
  }
  .matrix-cell {
