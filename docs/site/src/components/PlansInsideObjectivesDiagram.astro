{/*
  Plans inside objectives, conforming to the shared diagram legend and rendering contract in
  docs/design/docs-site-visual-blueprint.md §5. The hand-authored inline SVG uses only the bound
  theme tokens, keeps operational labels in IBM Plex Mono at 16px or larger, and carries the
  same labeled relationship in wide and narrow reading orders.

  One figure wraps two fully named SVG variants. The @container query on the figure's inline
  size (compositions.css makes figure.perk-diagram an inline-size container) removes one
  variant from both rendering and the accessibility tree at every width — narrow by default,
  wide only where the content column fits its 736-unit viewBox at scale 1, so every label
  renders at its declared ≥16px size; browsers without container-query support keep the
  content-identical narrow variant. Each variant states the current node in its description
  because color and line weight only reinforce that status. The neighboring MDX copy supplies
  the required textual equivalent.
*/}

<figure class="perk-diagram">
  <svg
    role="img"
    data-variant="wide"
    viewBox="0 0 736 290"
    aria-labelledby="perk-plans-objectives-wide-title perk-plans-objectives-wide-desc"
  >
    <title id="perk-plans-objectives-wide-title">Plans inside an objective</title>
    <desc id="perk-plans-objectives-wide-desc">
      An Objective, stored as a durable issue, contains three roadmap nodes: 1.1 is complete,
      1.2 is current, and 1.3 is pending. A solid arrow labeled "perk objective plan" leads
      from the current node to a plan issue, a solid arrow labeled "implement" leads to a pull
      request, and a solid return arrow labeled "merge → node done + reconcile" leads back to
      the objective.
    </desc>
    <g>
      <rect class="objective" x="2" y="8" width="248" height="210" rx="10" />
      <text class="region-heading" x="20" y="38">Objective (durable issue)</text>

      <rect class="node complete" x="20" y="54" width="210" height="40" rx="6" />
      <text class="node-label complete-label" x="36" y="80">✓ 1.1</text>

      <rect class="node current" x="20" y="105" width="210" height="40" rx="6" />
      <text class="node-label current-label" x="36" y="131">▸ 1.2</text>

      <rect class="node" x="20" y="156" width="210" height="40" rx="6" />
      <text class="node-label" x="36" y="182">○ 1.3</text>

      <line class="connector" x1="230" y1="125" x2="416" y2="125" />
      <polygon class="arrowhead" points="416,120 416,130 426,125" />
      <text class="edge-label" x="323" y="111">perk objective plan</text>

      <rect class="artifact" x="426" y="88" width="40" height="24" rx="6" />
      <rect class="artifact" x="426" y="100" width="110" height="50" rx="6" />
      <text class="artifact-label" x="438" y="132">plan issue</text>

      <line class="connector" x1="536" y1="125" x2="646" y2="125" />
      <polygon class="arrowhead" points="646,120 646,130 656,125" />
      <text class="edge-label" x="591" y="111">implement</text>

      <rect class="artifact" x="656" y="88" width="34" height="24" rx="6" />
      <rect class="artifact" x="656" y="100" width="70" height="50" rx="6" />
      <text class="artifact-label" x="681" y="132">PR</text>

      <path class="connector" d="M 691 150 V 240 H 127 V 228" />
      <polygon class="arrowhead" points="122,228 132,228 127,218" />
      <text class="edge-label" x="410" y="272">merge → node done + reconcile</text>
    </g>
  </svg>

  <svg
    role="img"
    data-variant="narrow"
    viewBox="0 0 288 624"
    aria-labelledby="perk-plans-objectives-narrow-title perk-plans-objectives-narrow-desc"
  >
    <title id="perk-plans-objectives-narrow-title">Plans inside an objective (stacked)</title>
    <desc id="perk-plans-objectives-narrow-desc">
      Stacked top to bottom, an Objective stored as a durable issue contains three roadmap
      nodes: 1.1 is complete, 1.2 is current, and 1.3 is pending. A solid arrow labeled "perk
      objective plan" leads from the current node to a plan issue, a solid arrow labeled
      "implement" leads to a pull request, and a solid return arrow labeled "merge → node done
      + reconcile" leads back to the objective.
    </desc>
    <g>
      <rect class="objective" x="18" y="8" width="252" height="208" rx="10" />
      <text class="region-heading" x="32" y="38">Objective (durable issue)</text>

      <rect class="node complete" x="32" y="54" width="224" height="38" rx="6" />
      <text class="node-label complete-label" x="48" y="79">✓ 1.1</text>

      <rect class="node current" x="32" y="104" width="224" height="38" rx="6" />
      <text class="node-label current-label" x="48" y="129">▸ 1.2</text>

      <rect class="node" x="32" y="154" width="224" height="38" rx="6" />
      <text class="node-label" x="48" y="179">○ 1.3</text>

      <path class="connector" d="M 256 123 H 276 V 258 H 144 V 274" />
      <polygon class="arrowhead" points="139,274 149,274 144,284" />
      <text class="edge-label side" x="32" y="248">perk objective plan</text>

      <rect class="artifact" x="48" y="284" width="48" height="24" rx="6" />
      <rect class="artifact" x="48" y="296" width="192" height="58" rx="6" />
      <text class="artifact-label" x="80" y="331">plan issue</text>

      <line class="connector" x1="144" y1="354" x2="144" y2="398" />
      <polygon class="arrowhead" points="139,398 149,398 144,408" />
      <text class="edge-label side" x="162" y="384">implement</text>

      <rect class="artifact" x="80" y="408" width="42" height="24" rx="6" />
      <rect class="artifact" x="80" y="420" width="128" height="58" rx="6" />
      <text class="artifact-label" x="128" y="455">PR</text>

      <path class="connector" d="M 208 449 H 276 V 568 H 8 V 36 H 10" />
      <polygon class="arrowhead" points="10,31 10,41 18,36" />
      <text class="edge-label" x="144" y="602">merge → node done + reconcile</text>
    </g>
  </svg>
</figure>

<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
  }
  svg[data-variant="wide"] {
    max-width: 736px;
    display: none;
  }
  svg[data-variant="narrow"] {
    max-width: 288px;
  }
  @container (min-width: 736px) {
    svg[data-variant="wide"] {
      display: block;
    }
    svg[data-variant="narrow"] {
      display: none;
    }
  }

  .objective {
    fill: var(--perk-surface);
    stroke: var(--perk-border);
    stroke-width: 1;
  }
  .node {
    fill: var(--perk-canvas);
    stroke: var(--perk-border);
    stroke-width: 1;
  }
  .node.complete {
    fill: var(--perk-success-low);
    stroke: var(--perk-success);
  }
  .node.current {
    fill: var(--sl-color-accent-low);
    stroke: var(--perk-accent-strong);
    stroke-width: 2;
  }
  .artifact {
    fill: var(--sl-color-accent-low);
    stroke: var(--perk-border);
    stroke-width: 1;
  }
  .region-heading,
  .node-label,
  .artifact-label,
  .edge-label {
    font-family: var(--sl-font-mono), monospace;
    font-size: 16px;
    font-weight: 500;
    fill: var(--perk-text);
  }
  .complete-label {
    fill: var(--perk-success);
  }
  .current-label {
    fill: var(--perk-accent-strong);
  }
  .connector {
    fill: none;
    stroke: var(--perk-muted);
    stroke-width: 1;
  }
  .arrowhead {
    fill: var(--perk-muted);
  }
  .edge-label {
    fill: var(--perk-muted);
    text-anchor: middle;
  }
  .edge-label.side {
    text-anchor: start;
  }
</style>
